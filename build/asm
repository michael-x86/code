#!/bin/bash
set -e

# ── Paths ──────────────────────────────────────────────────────────
PROJECT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
BUILD_DIR="$(cd "$(dirname "$0")" && pwd)"

BOOT_ASM="${PROJECT_DIR}/kernel/bootloader.asm"
KERNEL_ASM="${PROJECT_DIR}/kernel/kernel.asm"
KERNEL_INC_DIR="${PROJECT_DIR}/kernel"
IMG="${BUILD_DIR}/os.img"

# Programs to compile
COMMANDS=(exit help dump alloc dealloc poke peek
          ps vi pwd ls cd ping cat touch write
          rm rmdir mkdir cp mv calc invaders)

RUN_QEMU=false
FULLSCREEN=false
DEBUG=false
INDEX_ONLY=false

while [[ $# -gt 0 ]]; do
    case $1 in
        -r|--run)        RUN_QEMU=true; shift;;
        -f|--fullscreen) FULLSCREEN=true; RUN_QEMU=true; shift;;
        -d|--debug)      DEBUG=true; RUN_QEMU=true; shift;;
        -i|--index)      INDEX_ONLY=true; shift;;
        -h|--help)
            cat <<EOF
Usage: ./asm [options]
  -r, --run         Compile and run in QEMU
  -f, --fullscreen  Run in fullscreen
  -d, --debug       Run with GDB on localhost:1234
  -i, --index       Run the code indexing pipeline (and exit)
  -h, --help        Show this help
EOF
            exit 0;;
        *) echo "Unknown option: $1"; exit 1;;
    esac
done

if [[ "$INDEX_ONLY" == true ]]; then
    echo "[Index] Building code search index..."
    "${PROJECT_DIR}/scripts/code-index-build.py" --root "${PROJECT_DIR}" --out "${BUILD_DIR}/code-index/code-index.sqlite"
    echo "[Index] Index built at ${BUILD_DIR}/code-index/code-index.sqlite"
    exit 0
fi

# Content directories (source trees scanned by gen_fs.py)
mkdir -p "${BUILD_DIR}/bin" "${BUILD_DIR}/proc" "${BUILD_DIR}/var/log"
mkdir -p "${BUILD_DIR}/usr" "${BUILD_DIR}/dev" "${BUILD_DIR}/lib" "${BUILD_DIR}/etc"

echo "[1/6] Building commands..."
for p in "${COMMANDS[@]}"; do
    src="${PROJECT_DIR}/commands/${p}.asm"
    out="${BUILD_DIR}/bin/${p}"
    if [[ ! -f "$src" ]]; then
        echo "  ! missing $src — skipping"
        continue
    fi
    nasm -f bin "$src" -o "$out"
    sz=$(stat -c%s "$out")
    if (( sz > 4096 )); then
        echo "ERROR: $src compiled to $sz bytes (max 4096)" >&2
        exit 1
    fi
    echo "  + bin/$p ($sz bytes)"
done

echo "[2/6] Generating filesystem image..."
cd "$BUILD_DIR"
python3 gen_fs.py "$BUILD_DIR" fs.bin | sed 's/^/  /'

echo "[3/6] Assembling kernel..."
nasm -f bin "$KERNEL_ASM" -o "${BUILD_DIR}/kernel.bin" -I "${KERNEL_INC_DIR}/"

KERNEL_SIZE=$(stat -c%s "${BUILD_DIR}/kernel.bin")
KERNEL_SECTORS=$(((KERNEL_SIZE + 511) / 512))
KERNEL_BYTES=$((KERNEL_SECTORS * 512))
echo "[4/6] Kernel size: $KERNEL_SIZE bytes ($KERNEL_SECTORS sectors)"
sed -i "s/^KERNEL_SECTORS.*/KERNEL_SECTORS  equ 0x$(printf '%02X' $KERNEL_SECTORS)/" "$BOOT_ASM"

echo "[5/6] Assembling bootloader..."
nasm -f bin "$BOOT_ASM" -o "${BUILD_DIR}/bootloader.bin"

echo "[6/6] Linking os.img..."
FS_BIN_SIZE=$(stat -c%s "${BUILD_DIR}/fs.bin")
FS_SECTORS=$(((FS_BIN_SIZE + 511) / 512))
FS_LBA=$((KERNEL_SECTORS + 1))  # FS region starts right after kernel

# Total image size = bootloader(1) + kernel(KERNEL_SECTORS) + fs(FS_SECTORS)
TOTAL_SECTORS=$((1 + KERNEL_SECTORS + FS_SECTORS))
TARGET=$((TOTAL_SECTORS * 512))

# Concatenate: bootloader + kernel (padded to sector boundary) + fs.bin
# Pad kernel to KERNEL_SECTORS * 512 bytes so the disk has zeros between
# the kernel and the filesystem (prevents BSS corruption during copy)
KERNEL_PADDED=$(mktemp)
cat "${BUILD_DIR}/kernel.bin" > "$KERNEL_PADDED"
truncate -s "$KERNEL_BYTES" "$KERNEL_PADDED"
cat "${BUILD_DIR}/bootloader.bin" "$KERNEL_PADDED" "${BUILD_DIR}/fs.bin" > "$IMG"
truncate -s "$TARGET" "$IMG"
rm -f "$KERNEL_PADDED"

echo ""
echo "Build complete: $IMG ($(stat -c%s "$IMG") bytes)"
echo "  Bootloader: LBA 0 (1 sector)"
echo "  Kernel:     LBA 1..${KERNEL_SECTORS} (${KERNEL_SECTORS} sectors)"
echo "  FS:         LBA ${FS_LBA}..$((FS_LBA + FS_SECTORS - 1)) (${FS_SECTORS} sectors)"
echo ""
rm -f "${BUILD_DIR}/kernel.bin" "${BUILD_DIR}/bootloader.bin"
rm -f "${BUILD_DIR}/fs.bin"

if [[ "$RUN_QEMU" == true ]]; then
    QEMU_ARGS=(
        -drive format=raw,file="$IMG",index=0,if=ide
        -device isa-debug-exit,iobase=0xf4,iosize=0x04
        -m 128
    )

    if [[ "$FULLSCREEN" == true ]]; then
        QEMU_ARGS+=(--full-screen)
        echo "Mode: FULLSCREEN (Ctrl+Alt+F to exit)"
    else
        echo "Mode: WINDOWED"
    fi

    if [[ "$DEBUG" == true ]]; then
        QEMU_ARGS+=(-gdb tcp::1234 -S)
        echo "Debug: GDB on localhost:1234"
    fi
    echo ""
    qemu-system-i386 "${QEMU_ARGS[@]}"
else
    echo "To run: ./asm -r    (fullscreen: -f    gdb: -d)"
fi
