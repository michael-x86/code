#!/bin/bash
set -e

# ── Paths ──────────────────────────────────────────────────────────
PROJECT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
BUILD_DIR="$(cd "$(dirname "$0")" && pwd)"

BOOT_ASM="${PROJECT_DIR}/kernel/bootloader.asm"
KERNEL_ASM="${PROJECT_DIR}/kernel/src/kernel.asm"
KERNEL_INC_DIR="${PROJECT_DIR}/kernel/src/includes"
IMG="${BUILD_DIR}/os.img"

# Programs to compile
COMMANDS_DIR="${PROJECT_DIR}/kernel/src/commands"
COMMANDS=(exit help env debug dump alloc dealloc poke peek
          ps vi pwd ls cd ping cat touch write launcher
          rm rmdir mkdir cp mv calc invaders zork gdemo elite enigma up morse)
RUN_QEMU=false
FULLSCREEN=false
DEBUG=false
INDEX_ONLY=false

while [[ $# -gt 0 ]]; do
    case $1 in
        -r|--run)        RUN_QEMU=true; shift;;
        -f|--fullscreen) FULLSCREEN=true; RUN_QEMU=true; shift;;
        -d|--debug)      DEBUG=true; RUN_QEMU=true; shift;;
        -i|--index)      INDEX_ONLY=true; shift;;
        -h|--help)
            cat <<EOF
Usage: ./asm [options]
  -r, --run         Compile and run in QEMU
  -f, --fullscreen  Run in fullscreen
  -d, --debug       Run with GDB on localhost:1234
  -i, --index       Run the code indexing pipeline (and exit)
  -h, --help        Show this help
EOF
            exit 0;;
        *) echo "Unknown option: $1"; exit 1;;
    esac
done

if [[ "$INDEX_ONLY" == true ]]; then
    echo "[Index] Building code search index..."
    "${PROJECT_DIR}/scripts/code-index-build.py" --root "${PROJECT_DIR}" --out "${BUILD_DIR}/code-index/code-index.sqlite"
    echo "[Index] Index built at ${BUILD_DIR}/code-index/code-index.sqlite"
    exit 0
fi

# Content directories (source trees scanned by gen_fs.py)
mkdir -p "${BUILD_DIR}/bin" "${BUILD_DIR}/proc" "${BUILD_DIR}/var/log"
mkdir -p "${BUILD_DIR}/usr" "${BUILD_DIR}/dev" "${BUILD_DIR}/lib" "${BUILD_DIR}/etc"

# Copy static content from kernel/ into the build filesystem tree
echo "[0/6] Populating filesystem content directories..."
for f in "${PROJECT_DIR}/kernel/etc/"*; do
    [[ -f "$f" ]] && cp "$f" "${BUILD_DIR}/etc/"
done
for f in "${PROJECT_DIR}/kernel/proc/"*; do
    [[ -f "$f" ]] && cp "$f" "${BUILD_DIR}/proc/"
done
for f in "${PROJECT_DIR}/kernel/var/log/"*; do
    [[ -f "$f" ]] && cp "$f" "${BUILD_DIR}/var/log/"
done

echo "[1/6] Building commands..."
for p in "${COMMANDS[@]}"; do
    src="${COMMANDS_DIR}/${p}.asm"
    out="${BUILD_DIR}/bin/${p}"
    if [[ ! -f "$src" ]]; then
        echo "  ! missing $src — skipping"
        continue
    fi
    nasm -f bin -i "${PROJECT_DIR}/kernel/src/lib/" "$src" -o "$out"
    sz=$(stat -c%s "$out")
    if (( sz > 65536 )); then
        echo "ERROR: $src compiled to $sz bytes (max 65536)" >&2
        exit 1
    fi
    echo "  + bin/$p ($sz bytes)"
done

echo "[2/6] Generating filesystem image..."
cd "$BUILD_DIR"
python3 gen_fs.py "$BUILD_DIR" fs.bin | sed 's/^/  /'

# Boot splash: convert voss-haas.png to raw 640x400 8-bit indexed pixel data
echo "[+ ] Converting boot splash image..."
python3 "${PROJECT_DIR}/build/convert_splash.py" "${PROJECT_DIR}"

echo "[3/6] Assembling kernel..."
nasm -f bin "$KERNEL_ASM" -o "${BUILD_DIR}/kernel.bin" \
    -l "${BUILD_DIR}/kernel.lst" \
    -I "${BUILD_DIR}/" \
    -I "${KERNEL_INC_DIR}/" \
    -I "${KERNEL_INC_DIR}/drivers/" \
    -I "${PROJECT_DIR}/kernel/src/" \
    -I "${PROJECT_DIR}/kernel/src/hal/" \
    -I "${PROJECT_DIR}/kernel/src/arch/" \
    -w-label-redef-late

KERNEL_SIZE=$(stat -c%s "${BUILD_DIR}/kernel.bin")
KERNEL_SECTORS=$(((KERNEL_SIZE + 511) / 512))
KERNEL_BYTES=$((KERNEL_SECTORS * 512))
echo "[4/6] Kernel size: $KERNEL_SIZE bytes ($KERNEL_SECTORS sectors)"
sed -i "s/^KERNEL_SECTORS.*/KERNEL_SECTORS  equ 0x$(printf '%02X' $KERNEL_SECTORS)/" "$BOOT_ASM"

echo "[5/6] Assembling bootloader..."
nasm -f bin "$BOOT_ASM" -o "${BUILD_DIR}/bootloader.bin"

echo "[6/6] Linking os.img..."

# Boot image: bootloader + kernel only (no FS — FS is on a separate disk)
BOOT_IMG="${BUILD_DIR}/boot.img"
KERNEL_PADDED=$(mktemp)
cat "${BUILD_DIR}/kernel.bin" > "$KERNEL_PADDED"
truncate -s "$KERNEL_BYTES" "$KERNEL_PADDED"
cat "${BUILD_DIR}/bootloader.bin" "$KERNEL_PADDED" > "$BOOT_IMG"
rm -f "$KERNEL_PADDED"

# FS image: raw fs.bin on a separate disk
FS_IMG="${BUILD_DIR}/fs.img"
cp "${BUILD_DIR}/fs.bin" "$FS_IMG"

# Final image for compatibility: boot + fs concatenated
cat "$BOOT_IMG" "$FS_IMG" > "$IMG"

echo ""
echo "Build complete:"
echo "  Boot: $BOOT_IMG (bootloader + kernel)"
echo "  FS:   $FS_IMG (filesystem, separate disk)"
echo "  OS:   $IMG (combined, $(stat -c%s "$IMG") bytes)"
echo ""

# Extract ACPI symbol addresses for webulator tests
python3 "${PROJECT_DIR}/build/extract_syms.py" "${BUILD_DIR}/kernel.bin" \
    "acpi_init,rsdt_found,fadt_address" > "${BUILD_DIR}/kernel-syms.json"

# Copy binaries for webulator (x86 web emulator)
WEBULATOR_DIR="${PROJECT_DIR}/webulator/kernel-bin"
mkdir -p "$WEBULATOR_DIR"
cp "${BUILD_DIR}/kernel.bin" "${BUILD_DIR}/bootloader.bin" "$WEBULATOR_DIR/"
cp "${BUILD_DIR}/kernel-syms.json" "$WEBULATOR_DIR/"
# The webulator expects a combined disk image for ATA emulation
cp "$IMG" "$WEBULATOR_DIR/os.img"
echo "[webulator] Copied kernel.bin, bootloader.bin, kernel-syms.json, os.img → $WEBULATOR_DIR"

rm -f "${BUILD_DIR}/kernel.bin" "${BUILD_DIR}/bootloader.bin"
rm -f "${BUILD_DIR}/fs.bin"

if [[ "$RUN_QEMU" == true ]]; then
    # Boot disk on primary master (ide.0, unit=0), FS disk on primary slave
    # (ide.0, unit=1) — matches the bootloader's handoff at [0x500..0x50C],
    # which sets fs_ata_base=0x1F0 and fs_ata_drive=0xF0 (primary slave).
    # Both disks on the same controller means index=0/1 with if=ide works
    # correctly here (QEMU assigns them as master/slave on the same bus).
    #NEW ARGS (explicit bus assignment, secondary controller):
    #QEMU_ARGS=(
    #    -drive id=boot,format=raw,file="$BOOT_IMG",if=none
    #    -drive id=fs,format=raw,file="$FS_IMG",if=none
    #    -device ide-hd,bus=ide.0,drive=boot,unit=0
    #    -device ide-hd,bus=ide.1,drive=fs,unit=0
    #    -device isa-debug-exit,iobase=0xf4,iosize=0x04
    #    -m 128
    #)
    #OLD ARGS (master/slave on primary controller — matches bootloader):
    QEMU_ARGS=(
        -drive format=raw,file="$BOOT_IMG",index=0,if=ide
        -drive format=raw,file="$FS_IMG",index=1,if=ide
        -device isa-debug-exit,iobase=0xf4,iosize=0x04
        -vga std
        -m 128
    )

    if [[ "$FULLSCREEN" == true ]]; then
        QEMU_ARGS+=(--full-screen)
        echo "Mode: FULLSCREEN (Ctrl+Alt+F to exit)"
    else
        echo "Mode: WINDOWED"
    fi

    if [[ "$DEBUG" == true ]]; then
        QEMU_ARGS+=(-gdb tcp::1234 -S)
        echo "Debug: GDB on localhost:1234"
    fi
    echo ""
    qemu-system-i386 "${QEMU_ARGS[@]}"
else
    echo "To run: ./asm -r    (fullscreen: -f    gdb: -d)"
fi
