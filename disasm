#!/bin/bash

if [[ $# -gt 0 ]]
then
    echo "Header bytes:"
    xxd -g1 -l56 -o0x00000000  "$1"

    echo
    echo "Code:"

    ndisasm -b32 -e0 -o0x00000000 "$1" |head -10
    #ndisasm -b32 -e8 "$1" | head -10
    #xxd -g1 -l8 -o0x08000049  "$1"
else
    echo
    echo "Usage: disasm bin/{file}"

fi

