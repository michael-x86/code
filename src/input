; -----------------------------------------
; returns:
;   al = ascii char
;   al = 0 if no key
; -----------------------------------------
get_key:
    mov eax,[kbd_tail]
    cmp eax,[kbd_head]
    je .empty
    mov bl,[kbd_buf+eax]
    inc eax
    and eax,255
    mov [kbd_tail],eax
    mov al,bl
    test al,al
    jz .empty

    ;xor ebx,ebx     ;key code
    ;movsx ebx,al
    ;mov eax,6
    ;int 0x80

    ; -------------------------
    ; arrow up
    ; -------------------------
    cmp al,0x48
    jne .check_down
    call hist_back
    xor al,al
    ret
.check_down:
    ; -------------------------
    ; arrow down
    ; -------------------------
    cmp al,0x50
    jne .translate
    call hist_frwd
    xor al,al
    ret
.translate:
    ;cmp al,0x01          ; breaks vi
    ;je  shutdown         ;escape key
    ; reject invalid scancodes
    cmp al,128
    jae .invalid   ; Work to be done...
    movzx eax,al
    ; -------------------------
    ; choose keymap
    ; -------------------------
    cmp byte [kbd_shift],0
    jne .shifted
.normal:
    mov al,[keymap+eax]
    ret
shifted:
    mov al,[keymap_shift+eax]
    ret
.empty:
    xor al,al
    ret
.invalid:
    mov al,'?'
    ret

; --- The final curtain call    ---
; --- powering down the theater ---
shutdown:
    cli
    mov dx,0xF4
    mov al,0
    out dx,al
    hlt
    ret

; --- print 8 hex digits at top-right ----
; Counting heartbeats of the system clock
sys_tick:
    pushad
    mov eax,[tick_count]
    mov edi,0xC00B8000+(1*80+71)*2
    mov ecx,8
.next:
    mov edx,eax
    shr edx,28
    and dl,0x0F
    add dl,'0'
    cmp dl,'9'
    jbe .store
    add dl,7
.store:
    mov dh,0x07
    mov dh,0x0C
    mov dh,0x07
    mov [edi],dx
    shl eax,4
    add edi,2
    dec ecx
    jnz .next
    popad
    ret

