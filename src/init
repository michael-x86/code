kernel_main:
    call build_idt
    call set_irq0
    call set_irq1
    call set_syscall
    lidt [idt_descriptor]
    call pic_remap
    call set_freq
    call init_bounce
    call hwclock

    mov edi,cwd_buf
    mov ecx,128
    xor eax,eax
    rep stosb
    mov byte [cwd_buf],'/'

    call load_fs_persist
    call cls
    call sys_banner
    mov eax,80*2
    mov [cursor_pos],eax
    call newline
    call prompt

    call init_tasks

    mov [task0_esp],esp
    mov dword [current_task],0
    sti


