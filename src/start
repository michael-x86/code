global start

bits 32

start:
    cli
    mov ax,0x10     ; DATA_SEG (GDT)
    mov ds,ax
    mov es,ax
    mov ss,ax
    mov fs,ax
    mov gs,ax

    call .get_pc
.get_pc:
    pop ebp
    sub ebp,.get_pc

    ; --- physical stack ---
    lea esp,[stack_top+ebp]
    push ebp
    pushad

    call page_mapping

    lea eax, [page_directory+ebp]
    mov cr3,eax

    ; Enable Paging
    mov eax,cr0
    or eax,0x80000000
    mov cr0,eax

    ; Jump to virtual memory
    mov eax,higher_half
    jmp eax


