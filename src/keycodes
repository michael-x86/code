;---- Keycode -> ASCII Convertion ----
kbd_shift db 0

section .rodata
; -----------------------------------------
; normal keymap
; -----------------------------------------

keymap:
    db 0,27,'1','2','3','4','5','6','7','8'
    db '9','0','-','=',8,9
    db 'q','w','e','r','t','y','u','i'
    db 'o','p','[',']',13,0
    db 'a','s','d','f','g','h','j','k'
    db 'l',';',39,'`',0,'\'
    db 'z','x','c','v','b','n','m'
    db ',','.','/',0,'*',0,' '
    times 0x3B-($-keymap) db 0     ; F1
    db '<'
    times 256-($-keymap) db 0


; -----------------------------------------
; shift keymap
; -----------------------------------------

keymap_shift:
    db 0,27,'!','@','#','$','%','^','&','*'
    db '(' ,')','_','+',8,9
    db 'Q','W','E','R','T','Y','U','I'
    db 'O','P','{','}',13,0
    db 'A','S','D','F','G','H','J','K'
    db 'L',':','"', '~',0,'|'
    db 'Z','X','C','V','B','N','M'
    db '<','>','?',0,'*',0,' '
    times 0x3B-($-keymap_shift) db 0     ; F1
    db '<'
    times 256-($-keymap_shift) db 0

