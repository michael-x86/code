
sys_peek:
    push eax
    push esi
    mov eax,[argc]
    cmp eax,2
    jl .arguse
    mov esi,[argv+4]
    call sys_hex2int   ;in esi {str} out eax {int}
    call newline
    mov esi,eax
    mov ecx,4
.loop:
    lodsb
    call sys_hex_byte
    mov al,' '
    call putchar
.cont:
    loop .loop
    call newline
    call newline
.done:
    pop esi
    pop eax
    ret
.arguse:
    mov esi,peek_msg
    call print_cr
    pop esi
    pop eax
    ret

sys_poke:
    push eax
    push esi
    mov eax,[argc]
    cmp eax,3
    jl .usage
    mov esi,[argv+4]
    call sys_hex2int
    mov edi,eax
    mov esi,[argv+8]
    call sys_hex2int
    mov [edi],eax
.done:
    pop esi
    pop eax
    ret
.usage:
    mov esi,poke_msg
    call print_cr
    pop esi
    pop eax
    ret

sys_plot:
    pushad
    mov eax,[argc]
    cmp eax,3
    jl .usage
    mov esi,[argv+4]
    call sys_asc2int
    mov ecx,edx
    cmp eax,80
    jge .usage

    mov esi,[argv+8]
    call sys_asc2int

    mov eax,edx
    mov edx,ecx
    mov ecx,eax

    imul ecx,80
    add ecx,edx
    shl ecx,1
    call show_regs
    mov edi,0xC00B8000
    add edi,ecx
    mov byte [edi],0xDB
    inc edi
    mov byte [edi],0x06
    popad
    ret
.usage:
    mov esi,plot_msg
    call print_cr
    popad
    ret

sys_epoch:
    mov ebx,[boot_epoch]
    ret

